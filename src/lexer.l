/* lexer.l — Flex tokenizer for the .dim physics language (Balraj).
 *
 * Design notes:
 *  - Unit literals (meters, kg, K, A, cd, mol, ...) are FIRST-CLASS tokens:
 *    known unit words become UNIT; everything else becomes ID.
 *  - Single source of truth for the unit word list is unitvec.c
 *    (uv_is_unit_word) — never duplicate it here.
 *  - Classic flex style (tested against flex 2.5.4): no %option yylineno,
 *    we count lines ourselves for portability.
 *  - Locations come from bison's %locations; we set yylloc.first_line before
 *    each return so the parser can report exact lines.
 */
%{
#include <stdlib.h>
#include "ast.h"        /* dim_strdup; also required before parser.tab.h */
#include "common.h"
#include "unitvec.h"
#include "parser.tab.h" /* generated by bison: YYSTYPE, token codes, yylloc */

int yylineno     = 1;   /* hand-managed (portable across flex versions) */
int g_lex_errors = 0;
%}

%option noyywrap

%%

"#"[^\n]*     ;    /* # comment */
"//"[^\n]*    ;    /* C++-style comment, also legal */

[0-9]+\.[0-9]+([eE][+-]?[0-9]+)? {
    yylloc.first_line = yylineno;
    yylval.num = atof(yytext);
    return NUM;
}

[0-9]+([eE][+-]?[0-9]+)? {
    yylloc.first_line = yylineno;
    yylval.num = atof(yytext);     /* atof handles int + scientific too */
    return NUM;
}

"let" {
    yylloc.first_line = yylineno;
    return LET;
}

[A-Za-z_][A-Za-z_0-9]* {
    yylloc.first_line = yylineno;
    yylval.str = dim_strdup(yytext);
    if (uv_is_unit_word(yytext))
        return UNIT;          /* meters, kg, K, A, cd, mol, ft, ... */
    return ID;
}

\n { yylineno++; }

[ \t\r]+ ;   /* whitespace */

"+"|"-"|"*"|"/"|"^"|"("|")"|";"|"=" {
    yylloc.first_line = yylineno;
    return yytext[0];        /* single-char tokens carry their own code */
}

. {
    g_lex_errors++;
    DIM_ERR("lexer: illegal character '%s' (line %d)", yytext, yylineno);
}

%%

/* Explicit scanner teardown (Balraj, final QA): flex 2.5.4 keeps the input
 * buffer (yy_buffer_state + its yy_ch_buf, ~16 KB) alive for the whole
 * process by design. The allocation-ledger audit caught it, and a leak
 * inside MY stage shouldn't be forgiven when one function releases it
 * cleanly. Drivers call this right before return (see frontend_main.c /
 * src/main.c). No observable behavior change — stdout/stderr/exit codes. */
void lexer_release_scanner(void);

void lexer_release_scanner(void) {
    if (yy_current_buffer) {
        yy_delete_buffer(yy_current_buffer);
        yy_current_buffer = NULL;
    }
}

